<mxfile host="app.diagrams.net" modified="2026-11-03T17:37:00.000Z" agent="Antigravity Agent" version="24.0.0" type="device">
  <diagram id="system-architecture" name="System Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Polyglot System Architecture — Next.js 14 + MySQL 8 + MongoDB Atlas" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="670" height="30" as="geometry" />
        </mxCell>

        <!-- Tier 1: Client Layer -->
        <mxCell id="client_box" value="CLIENT TIER (Modern Web Browser)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontColor=#334155;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1040" height="110" as="geometry" />
        </mxCell>
        <mxCell id="client_student" value="&lt;b&gt;Student Portal UI&lt;/b&gt;&lt;br&gt;Browse Rooms, Filters,&lt;br&gt;Submit Apps, Track Beds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=11;" vertex="1" parent="client_box">
          <mxGeometry x="60" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="client_admin" value="&lt;b&gt;Admin / Warden Portal UI&lt;/b&gt;&lt;br&gt;Hostels, Rooms, Applications,&lt;br&gt;Atomic Allocations Modal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;fontSize=11;" vertex="1" parent="client_box">
          <mxGeometry x="410" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="client_auth" value="&lt;b&gt;Stateful Session Cookie&lt;/b&gt;&lt;br&gt;HTTP-only, Secure SameSite&lt;br&gt;Signed JWT (jose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="client_box">
          <mxGeometry x="760" y="40" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Tier 2: Next.js App Router Application Server -->
        <mxCell id="app_box" value="APPLICATION TIER (Next.js 14 App Router / Node.js Server Runtime)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontColor=#1E1B4B;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="1040" height="230" as="geometry" />
        </mxCell>
        <mxCell id="app_auth" value="&lt;b&gt;Auth &amp; RBAC Guard&lt;/b&gt;&lt;br&gt;`requireAuth()`&lt;br&gt;`requireAdmin()`&lt;br&gt;Bcrypt Password Hasher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=11;" vertex="1" parent="app_box">
          <mxGeometry x="40" y="45" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app_routes" value="&lt;b&gt;Route Handlers (REST APIs)&lt;/b&gt;&lt;br&gt;/api/hostels, /api/rooms&lt;br&gt;/api/applications&lt;br&gt;/api/allocations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=11;" vertex="1" parent="app_box">
          <mxGeometry x="270" y="45" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app_mysql_client" value="&lt;b&gt;MySQL Connection Pool&lt;/b&gt;&lt;br&gt;`mysql2/promise` Singleton&lt;br&gt;ACID Transactions&lt;br&gt;Stored Procedure Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="app_box">
          <mxGeometry x="530" y="45" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app_mongo_client" value="&lt;b&gt;MongoDB Client Singleton&lt;/b&gt;&lt;br&gt;Official `mongodb` Driver&lt;br&gt;Non-blocking Post-Commit&lt;br&gt;`logActivity()` Helper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="app_box">
          <mxGeometry x="790" y="45" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app_post_commit" value="&lt;b&gt;Post-Commit Event Flow:&lt;/b&gt; 1. Transact in MySQL (Source of Truth) &amp;rarr; 2. COMMIT &amp;rarr; 3. Log Audit Record in MongoDB Atlas (Decoupled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=11;fontColor=#1E3A8A;fontStyle=2;" vertex="1" parent="app_box">
          <mxGeometry x="40" y="150" width="960" height="40" as="geometry" />
        </mxCell>

        <!-- Tier 3: Polyglot Database Stores -->
        <mxCell id="db_mysql" value="PRIMARY DATA STORE: MySQL 8+ (InnoDB)&#xa;Relational ACID Source of Truth&#xa;&#xa;• Tables: users, hostels, room_types, rooms, applications, allocations&#xa;• Views: room_occupancy_summary (dynamic LEFT JOIN capacity)&#xa;• Stored Procedures: sp_allocate_room (SELECT ... FOR UPDATE)&#xa;• Triggers: trg_before_allocation_insert (Engine capacity check)&#xa;• Strategic Indexes: composite status, foreign keys, uniqueness" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="480" height="190" as="geometry" />
        </mxCell>

        <mxCell id="db_mongodb" value="SECONDARY DATA STORE: MongoDB Atlas (M0+)&#xa;High-Throughput Audit &amp; Event Store&#xa;&#xa;• Collection: activity_logs&#xa;• Schemaless flexible event payload (`details: {}`)&#xa;• Non-blocking audit record insertion&#xa;• Single-field and compound indexes on timestamp, action, users&#xa;• Analytical Aggregation Pipeline ($group by action volume)&#xa;• Reserved Admin Viewer endpoint for teammate" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="530" width="480" height="190" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="flow_client_app" value="HTTPS / JSON / Signed Cookies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#6366F1;strokeWidth=2;" edge="1" parent="1" source="client_box" target="app_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow_app_mysql" value="TCP / 3306 (Parameterized SQL, Locking, Stored Procedures)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="app_box" target="db_mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow_app_mongo" value="TCP / TLS SRV (Async Audit Log Document Ingestion)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="app_box" target="db_mongodb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
