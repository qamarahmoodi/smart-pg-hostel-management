# 
# Smart PG/Hostel Management System - Environment Variable Templates
# 
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local to Git version control.

# Application Configuration
NEXT_PUBLIC_APP_NAME="Smart PG & Hostel Management"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Secrets
# Generate a secure 32+ character random secret (e.g. `openssl rand -base64 32`)
AUTH_SECRET="smart-pg-hostel-management-default-secret-key-32-chars"
SESSION_COOKIE_NAME="smart_pg_session"
SESSION_MAX_AGE_SECONDS=604800

# MySQL Database Configuration (Primary Relational Store)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password_here"
MYSQL_DATABASE="smart_hostel_db"
MYSQL_CONNECTION_LIMIT=10

# MongoDB Atlas Configuration (Activity Logging Store)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hostel_management?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/hostel_management"
MONGODB_DB="hostel_management"
