# ============================================================
# Smart PG/Hostel Management System - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local to Git version control.

# Application Configuration
NEXT_PUBLIC_APP_NAME="Smart PG & Hostel Management"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Secrets
# Generate a secure 32+ character random secret (e.g. `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
SESSION_COOKIE_NAME="smart_pg_session"
SESSION_MAX_AGE_SECONDS=604800 # 7 days

# MySQL Database Configuration (Primary Relational Store)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="smart_pg_db"
MYSQL_CONNECTION_LIMIT=10

# MongoDB Atlas Configuration (Activity Logging Store)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_pg_logs?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/smart_pg_logs?retryWrites=true&w=majority"
MONGODB_DB="smart_pg_logs"
